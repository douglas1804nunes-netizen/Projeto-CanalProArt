# ============================================================
# CanalProArt — YouTube Trend Hunter + Content Factory
# Copie este arquivo para ".env" na raiz do projeto e preencha
# os valores. Nunca faça commit do ".env" real.
# ============================================================

NODE_ENV=development
PORT=3000

# --- Banco de dados (Postgres via docker-compose) ---
POSTGRES_USER=canalproart
POSTGRES_PASSWORD=canalproart
POSTGRES_DB=canalproart
DATABASE_URL=postgresql://canalproart:canalproart@localhost:5432/canalproart?schema=public

# --- Autenticação (definido na Fase 3) ---
JWT_SECRET=

# --- YouTube Data API v3 / OAuth (definido na Fase 4/5) ---
# Veja docs/YOUTUBE.md para o passo a passo de criação no Google Cloud Console.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
YOUTUBE_API_KEY=

# --- Criptografia dos tokens do YouTube (definido na Fase 4) ---
TOKEN_ENCRYPTION_KEY=

# --- Provedor de IA (definido na Fase 11) ---
# Provider ativo: anthropic | openai | gemini
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- URLs ---
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
